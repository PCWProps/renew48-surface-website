# Pressable deployment contract
# Source directory: wordpress/
# Destination directory: htdocs/wp-content/
# Keep repository governance and documentation out of runtime deploys.
# The source directory contains the runtime mu-plugins/wordpress/themes/plugins payload.
# Do not exclude JSON, JS, CSS, PHP, or media inside wordpress/.

/.git/
/.github/
/docs/
/logs/
/phase_*/
/*.md
/*.txt
/*.yml
/*.yaml
/*.zip
/*.tar
/*.gz
/.env*
/.DS_Store

# Preserve platform-managed WordPress runtime packages during sync.
# Pressable may evaluate patterns before or after the configured source path,
# so both repository-root and source-relative forms are intentionally covered.
/themes/
/plugins/
/wordpress/themes/
/wordpress/plugins/
